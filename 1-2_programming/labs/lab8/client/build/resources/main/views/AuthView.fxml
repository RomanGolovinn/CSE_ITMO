<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.text.Font?>

<!-- fx:controller указывает, какой класс Java управляет этим окном -->
<VBox alignment="CENTER" spacing="15.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="io.ui.gui.controllers.AuthController">
    <padding>
        <Insets bottom="40.0" left="40.0" right="40.0" top="40.0" />
    </padding>

    <!-- Переключатель языка -->
    <HBox alignment="TOP_RIGHT">
        <ComboBox fx:id="languageComboBox" prefWidth="150.0" />
    </HBox>

    <Label text="%auth.title">
        <font>
            <Font name="System Bold" size="24.0" />
        </font>
        <VBox.margin>
            <Insets bottom="20.0" />
        </VBox.margin>
    </Label>

    <TextField fx:id="loginField" promptText="%auth.login.prompt" prefHeight="35.0" />

    <PasswordField fx:id="passwordField" promptText="%auth.password.prompt" prefHeight="35.0" />

    <!-- Поле для вывода ошибок (красным цветом) -->
    <Label fx:id="errorLabel" textFill="RED" wrapText="true" />

    <HBox alignment="CENTER" spacing="20.0">
        <Button fx:id="loginButton" mnemonicParsing="false" onAction="#handleLogin" prefHeight="35.0" prefWidth="120.0" text="%auth.button.login" />
        <Button fx:id="registerButton" mnemonicParsing="false" onAction="#handleRegister" prefHeight="35.0" prefWidth="150.0" text="%auth.button.register" />
    </HBox>
</VBox>