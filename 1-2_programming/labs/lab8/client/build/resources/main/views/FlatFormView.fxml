<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="10.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="io.ui.gui.controllers.FlatFormController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
    <GridPane hgap="10.0" vgap="10.0">
        <Label text="%form.label.name" GridPane.columnIndex="0" GridPane.rowIndex="0" />
        <TextField fx:id="nameField" GridPane.columnIndex="1" GridPane.rowIndex="0" />

        <Label text="%form.label.area" GridPane.columnIndex="0" GridPane.rowIndex="1" />
        <TextField fx:id="areaField" GridPane.columnIndex="1" GridPane.rowIndex="1" />

        <Label text="%form.label.rooms" GridPane.columnIndex="0" GridPane.rowIndex="2" />
        <TextField fx:id="roomsField" GridPane.columnIndex="1" GridPane.rowIndex="2" />

        <Label text="%form.label.x" GridPane.columnIndex="0" GridPane.rowIndex="3" />
        <TextField fx:id="xField" GridPane.columnIndex="1" GridPane.rowIndex="3" />

        <Label text="%form.label.y" GridPane.columnIndex="0" GridPane.rowIndex="4" />
        <TextField fx:id="yField" GridPane.columnIndex="1" GridPane.rowIndex="4" />

        <Label text="%form.label.furnish" GridPane.columnIndex="0" GridPane.rowIndex="5" />
        <ComboBox fx:id="furnishComboBox" prefWidth="170.0" GridPane.columnIndex="1" GridPane.rowIndex="5" />

        <Label text="%form.label.view" GridPane.columnIndex="0" GridPane.rowIndex="6" />
        <ComboBox fx:id="viewComboBox" prefWidth="170.0" GridPane.columnIndex="1" GridPane.rowIndex="6" />

        <Label text="%form.label.transport" GridPane.columnIndex="0" GridPane.rowIndex="7" />
        <ComboBox fx:id="transportComboBox" prefWidth="170.0" GridPane.columnIndex="1" GridPane.rowIndex="7" />

        <Label text="%form.label.house.name" GridPane.columnIndex="0" GridPane.rowIndex="8" />
        <TextField fx:id="houseNameField" promptText="%form.prompt.house.name" GridPane.columnIndex="1" GridPane.rowIndex="8" />

        <Label text="%form.label.house.year" GridPane.columnIndex="0" GridPane.rowIndex="9" />
        <TextField fx:id="houseYearField" GridPane.columnIndex="1" GridPane.rowIndex="9" />

        <Label text="%form.label.house.floors" GridPane.columnIndex="0" GridPane.rowIndex="10" />
        <TextField fx:id="houseFloorsField" GridPane.columnIndex="1" GridPane.rowIndex="10" />
    </GridPane>
    <HBox alignment="CENTER_RIGHT" spacing="10.0">
        <Button mnemonicParsing="false" onAction="#handleCancel" text="%form.button.cancel" />
        <Button mnemonicParsing="false" onAction="#handleSave" text="%form.button.save" />
    </HBox>
</VBox>